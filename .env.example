# Eyes Up - Offline Bird-Call Companion
# Server settings (0.0.0.0 binds to local network/hotspot so your phone can connect)
HOST=0.0.0.0
PORT=8000

# SQLite Database
DATABASE_PATH=./data/eyes_up.db

# BirdNET Analysis settings
BIRDNET_CONFIDENCE_THRESHOLD=0.50
# Optional coordinates improve seasonal BirdNET filtering (e.g., Central Park NY: 40.78, -73.96)
BIRDNET_LATITUDE=
BIRDNET_LONGITUDE=

# Local LLM settings (Ollama + Gemma)
OLLAMA_HOST=http://localhost:11434
# Recommended offline model: gemma2:2b (or gemma:2b / gemma3:1b / gemma3:4b)
OLLAMA_MODEL=gemma2:2b

# Text-to-Speech (TTS) Settings
# Options: "browser" (uses mobile device native voice), "local_cli" (piper/espeak if installed), "elevenlabs" (cloud adapter)
TTS_ENGINE=browser
# ElevenLabs optional adapter (disabled by default)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
